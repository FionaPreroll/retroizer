{
    "name": "retroizer",
    "version": "2.0.0",
    "private": true,
    "description": "Turn images into retro pixel art: palette reduction (k-means) and pixelization in the browser.",
    "license": "GPL-3.0-only",
    "author": "Fiona <fipreroll+app@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/FionaPreroll/retroizer.git"
    },
    "homepage": "https://fionapreroll.github.io/retroizer/",
    "type": "module",
    "packageManager": "pnpm@12.23.0",
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:fuzz": "vitest run test/fuzz --testTimeout=0",
        "soak": "vite build && node e2e/soak.ts",
        "bench": "vite build && node bench/bench.ts",
        "showcase": "vite build && node e2e/showcase.ts",
        "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "~5.1.1",
        "eslint": "^10.15.0",
        "fast-check": "^4.11.0",
        "globals": "^17.14.0",
        "playwright": "1.65.1",
        "prettier": "^3.10.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.74.0",
        "vite": "^8.3.8",
        "vitest": "~5.1.1"
    },
    "dependencies": {
        "@fontsource/ibm-plex-mono": "5.3.0",
        "@fontsource/press-start-2p": "5.3.0"
    }
}
